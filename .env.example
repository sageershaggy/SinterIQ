# Innovista Research AI — local configuration
# All values remain server-side. Do not prefix secrets with VITE_.

HOST=127.0.0.1
PORT=3000
INNOVISTA_DATA_DIR=data

# Production only: exact HTTPS origin and a long random initial setup token.
# INNOVISTA_ORIGIN=https://research.example.com
# INNOVISTA_SETUP_TOKEN=
# Set only behind one trusted reverse proxy:
# INNOVISTA_TRUST_PROXY=1

# Optional 32-byte encryption master key, encoded as hex or base64.
# Otherwise generated in data/.innovista-encryption-key. Back it up with the DB.
# INNOVISTA_ENCRYPTION_KEY=

# Primary AI provider; keys can also be saved through Workspace settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible alternative (public HTTPS endpoint required).
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1

# The previous system’s SINTERIQ_ENCRYPTION_KEY is still read when migrating its encrypted keys.
# The name is kept because that is what existing environments already set.
# Legacy default passwords, auth secrets and auth bypass flags are not supported.
