# ============================================================
# PRODUCTION env for SinterIQ / Innovista Research AI.
#
# This file is an EXAMPLE and is committed. Its real-valued copy is NOT
# committed and is NOT stored on the VPS: upload it to Jenkins as a
# "Secret file" credential with ID **sinteriq-env**. The pipeline writes it
# next to docker-compose.prod.yml at deploy time and deletes it afterwards.
#
# Generate strong secrets:
#     openssl rand -base64 48       # INNOVISTA_SETUP_TOKEN
#     openssl rand -hex 32          # INNOVISTA_ENCRYPTION_KEY (32 bytes)
# ============================================================

# ---- Image coordinates ----
# One PRIVATE Docker Hub repo. This app is a single image, tagged app-<sha>
# (the same tag-prefix convention pomotoro uses for web-/api-).
# Must match the Jenkinsfile. IMAGE_TAG is overwritten by the pipeline per build.
REGISTRY=docker.io
IMAGE_OWNER=yasinshaikh111
IMAGE_REPO=sinteriq
IMAGE_TAG=latest

# ---- Localhost port on the shared VPS ----
# Must match `proxy_pass` in deploy/nginx/sinteriq.conf and be free on the box.
# In use as of the first deploy: 8080 8081 8090 8091 8092 8095 8096 8097 8100 9000
# (8100 is sagetrade-app). Verify with the recipe in docs/DEPLOYMENT.md section 4 --
# NOT with `ss`, which is not installed on this Alpine host and silently matches
# nothing, reporting a busy port as free.
APP_PORT=8110

# ---- Public site ----
# Exact HTTPS origin. The app refuses to start in production without https://,
# rejects any other Host header, and refuses cross-origin API requests.
INNOVISTA_ORIGIN=https://sinteriq.zengineeringapp.com

# ---- Initial administrator ----
# There is NO seeded/default admin and no default password by design. This
# token authorizes creating the first administrator from the live sign-in page.
# Rotate or blank it once that account exists.
INNOVISTA_SETUP_TOKEN=__openssl_rand_base64_48__

# ---- Encryption ----
# Optional 32-byte master key (hex or base64) for provider-key encryption at
# rest. Leave BLANK to let the app generate data/.innovista-encryption-key
# inside the sinteriq_data volume (then back the volume up as a whole).
# If you DO set it, it must never change, or stored provider keys stop
# decrypting. Back it up separately from the database.
INNOVISTA_ENCRYPTION_KEY=

# Legacy SinterIQ master key — only needed if the migrated legacy database has
# encrypted provider keys to carry over. Otherwise leave blank and re-enter the
# provider key in Workspace settings after deploy.
SINTERIQ_ENCRYPTION_KEY=

# ---- One-time legacy migration (DISABLED by default) ----
# Leave BLANK unless you are enabling the legacy import. The bind mount in
# docker-compose.prod.yml is commented out to match, and the Jenkinsfile's
# Deploy stage deliberately ABORTS the build if this names a path that is not
# an existing file — so a stale value here breaks every deploy.
#
# To enable: put the file on the host, set this to its path, AND uncomment the
# sintertechnik.db mount in docker-compose.prod.yml. The import only runs on
# first database initialization, so an already-initialized sinteriq_data volume
# must be removed first. See docs/DEPLOYMENT.md step 2.
#   LEGACY_DB_HOST_PATH=/srv/sinteriq/legacy/sintertechnik.db
LEGACY_DB_HOST_PATH=

# ---- AI provider (server-side only) ----
# NEVER a build arg and never VITE_-prefixed: these must not reach the browser
# bundle. Can alternatively be left blank here and set in Workspace settings,
# where they are stored encrypted at rest.
GEMINI_API_KEY=__your_gemini_api_key__
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible alternative (public HTTPS endpoint required).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
