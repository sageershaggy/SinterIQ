<?xml version='1.1' encoding='UTF-8'?>
<!--
  Jenkins job definition for SinterIQ / Innovista Research AI.
  "Pipeline script from SCM": Jenkins clones the repo and runs the root
  Jenkinsfile, so the pipeline stays version-controlled with the app.

  See README.md in this directory for how to import this file and which
  credentials to add first.

  Concurrency and build retention are declared in the Jenkinsfile's `options`
  block, which wins over anything set here, so they are deliberately omitted
  to keep one source of truth.
-->
<flow-definition plugin="workflow-job">
  <description>Innovista Research AI (SinterIQ) — build the app image, push to Docker Hub, deploy the isolated Compose stack behind the host nginx at https://sinteriq.zengineeringapp.com, then health-check /api/health with auto-rollback.</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <!-- Reuses the existing account-wide `github-https-pat` credential so
               the job is runnable without creating a new one. If that PAT does
               not cover this repo, switch to the per-app convention the other
               jobs use (pomotoro-scm / sagetrade-scm): create a read-only
               ed25519 deploy key as credential `sinteriq-scm` and use
                 <url>git@github.com:sageershaggy/SinterIQ.git</url>
                 <credentialsId>sinteriq-scm</credentialsId>
               See README.md in this directory. -->
          <url>https://github.com/sageershaggy/SinterIQ.git</url>
          <credentialsId>github-https-pat</credentialsId>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
