# ============================================================
# Build context for the SinterIQ / Innovista Research AI image.
#
# The image ships: dist/ (built bundle), server.ts, server/, shared/,
# scripts/ and production node_modules. Everything else is noise or secret.
# ============================================================

# Rebuilt inside the image
node_modules
dist
build
coverage

# Version control & CI
.git
.gitignore
.github
.prettierrc.json
.prettierignore

# Secrets and runtime state — NEVER bake these into a layer.
# Provider keys reach the container through compose `environment` only.
.env
.env.*
!.env.example
*.local

# Live data, databases and encryption keys (data/ is a named volume;
# sintertechnik.db is bind-mounted read-only at deploy time).
data
*.db
*.db-wal
*.db-shm
*.db-journal
.innovista-encryption-key
.sinteriq-encryption-key
.sinteriq-auth-secret

# Tests and generated fixtures (vite build does not need them)
tests
test-results
playwright-report
.tmp-*
.tmp_docx
*.tmp.json

# Docs. server/database.ts seeds the starter training library by reading
# ../docs/sintertechnik-training.md on first run (unguarded readFileSync),
# so that one file MUST stay in the image or a fresh DB crash-loops on boot.
docs/**
!docs/sintertechnik-training.md
# The criteria documents the Training library offers (server/criteria-templates.ts).
!docs/qualification-criteria
!docs/qualification-criteria/**

# Docker / deploy files themselves
Dockerfile
.dockerignore
docker-compose*.yml
Jenkinsfile
deploy

# Agent/dev tooling. None of it is part of the running app, and it is large:
# .claude alone is ~240 files of skill markdown as of b7c9bcb. The manual deploy
# happened to exclude .claude from its tar, but Jenkins builds from a git clone,
# so without these lines all of it lands in the build context.
#
# .claude-flow/{data,logs,sessions} is agent RUNTIME state and is gitignored,
# which means its contents are unreviewed — exactly what should never be copied
# toward a production image.
.claude
.claude-flow
.swarm
.agents
.mcp.json

# Logs, editor and OS cruft
*.log
npm-debug.log*
.chrome-debug
.vscode
.idea
.DS_Store
